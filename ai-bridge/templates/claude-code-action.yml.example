# PHASE 3 TEMPLATE — NOT ACTIVE. Claude Code running in GitHub Actions.
#
# This file does nothing where it is. To enable it, the owner copies it to
# .github/workflows/claude.yml in a PR (a sensitive path) after reading
# ai-bridge/docs/SETUP.md, step C. Check the action's README for changes first:
# https://github.com/anthropics/claude-code-action
#
# What it does: when the OWNER writes "@claude ..." in an issue or PR comment,
# Claude Code works on the request in a GitHub runner, pushes a branch and
# can open a PR. It never merges. Other people's comments are ignored.
#
# Authentication (choose one; store it as a repository secret, never in a file):
#   CLAUDE_CODE_OAUTH_TOKEN  from `claude setup-token` on your computer. Uses your
#                            Claude Pro/Max subscription limits, not API credits.
#   ANTHROPIC_API_KEY        from console.anthropic.com. Paid per token.
name: Claude (owner-triggered)

on:
  issue_comment:
    types: [created]
  pull_request_review_comment:
    types: [created]

permissions:
  contents: write
  pull-requests: write
  issues: write
  id-token: write

concurrency:
  group: claude-${{ github.event.issue.number || github.event.pull_request.number }}
  cancel-in-progress: false

jobs:
  claude:
    # Only the repository owner can start a run.
    if: contains(github.event.comment.body, '@claude') && github.event.comment.author_association == 'OWNER'
    runs-on: ubuntu-24.04
    timeout-minutes: 30
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          fetch-depth: 0
      - uses: anthropics/claude-code-action@12dd8d74c712f5f3669365b2369b558c495b1104 # v1.0.238
        with:
          claude_code_oauth_token: ${{ secrets.CLAUDE_CODE_OAUTH_TOKEN }}
          # anthropic_api_key: ${{ secrets.ANTHROPIC_API_KEY }}
          # Keep runs short and cheap; CLAUDE.md is read automatically.
          claude_args: "--max-turns 25"
