! Almond-Pure-Dark -- Openbox 3.6 window frame theme ("Almond Frame")
! Part of Almond Linux, AALDM edition. MIT License (Almond's own files);
! the Almond name and logo are excluded, see NOTICE in the repository root.
! Dark: dark brown title (active) / charcoal title (inactive), warm cream text.
! Flat solid textures only: no gradients, no bevels, no text shadows.
! Openbox themes style window frames only, never the inside of applications.

! ---- geometry: compact title bar, thin border
border.width: 1
padding.width: 4
padding.height: 3
window.handle.width: 0
window.client.padding.width: 0
window.client.padding.height: 0
window.label.text.justify: left
menu.border.width: 1
menu.overlap.x: 0
menu.overlap.y: 0
menu.separator.width: 1
menu.separator.padding.width: 6
menu.separator.padding.height: 3
osd.border.width: 1

! ---- active window
window.active.title.bg: flat solid
window.active.title.bg.color: #2B2118
window.active.label.bg: parentrelative
window.active.label.text.color: #F5DEB3
window.active.label.text.font: shadow=n
window.active.border.color: #D2A679
window.active.title.separator.color: #3D3022
window.active.client.color: #2B2118
window.active.handle.bg: flat solid
window.active.handle.bg.color: #2B2118
window.active.grip.bg: flat solid
window.active.grip.bg.color: #2B2118
window.active.button.unpressed.bg: parentrelative
window.active.button.unpressed.image.color: #F5DEB3
window.active.button.hover.bg: flat solid
window.active.button.hover.bg.color: #45372A
window.active.button.hover.image.color: #F5DEB3
window.active.button.pressed.bg: flat solid
window.active.button.pressed.bg.color: #5A4734
window.active.button.pressed.image.color: #F5DEB3
window.active.button.disabled.bg: parentrelative
