#!/bin/sh
# almond-install-icon: put "Install Almond Linux" on the desktop of the live
# session. Started once at login by /etc/xdg/autostart/almond-install-icon.desktop.
# Does nothing on an installed system or when the installer is missing.
# Part of Almond Linux. MIT License; see LICENSE and NOTICE.
# Status: Implemented (source exists, untested at runtime).

set -u
entry=/usr/share/applications/almond-install.desktop
[ -d /run/live/medium ] || exit 0
[ -f "$entry" ] || exit 0
command -v calamares >/dev/null 2>&1 || exit 0

desktop=$(xdg-user-dir DESKTOP 2>/dev/null)
[ -n "$desktop" ] && [ "$desktop" != "$HOME" ] || desktop="$HOME/Desktop"
mkdir -p "$desktop" || exit 0
cp "$entry" "$desktop/almond-install.desktop" && chmod 0755 "$desktop/almond-install.desktop"
