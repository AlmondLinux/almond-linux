[Icon Theme]
Name=Almond Pure Orange
Comment=Almond Pure with orange folders. Only folder icons live here; every other icon comes from Almond Pure.
Inherits=Almond-Pure
Example=folder
# Small sizes first: lookups return the first directory that matches, and the
# scalable directories match every size from 8 to 512. Type=Threshold lets
# the 16 px drawings serve 14-18 px requests and the 24 px drawings 20-28 px
# requests (a 22 px panel, for example) instead of only exact sizes.
Directories=16/mimetypes,16/places,24/mimetypes,24/places,scalable/mimetypes,scalable/places

[16/mimetypes]
Size=16
Context=MimeTypes
Type=Threshold
Threshold=2

[16/places]
Size=16
Context=Places
Type=Threshold
Threshold=2

[24/mimetypes]
Size=24
Context=MimeTypes
Type=Threshold
Threshold=4

[24/places]
Size=24
Context=Places
Type=Threshold
Threshold=4

[scalable/mimetypes]
Size=64
Context=MimeTypes
Type=Scalable
MinSize=8
MaxSize=512

[scalable/places]
Size=64
Context=Places
Type=Scalable
MinSize=8
MaxSize=512
