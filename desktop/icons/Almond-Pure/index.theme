[Icon Theme]
Name=Almond Pure
Comment=Flat, warm icon theme of Almond Linux (AALDM edition)
Inherits=Adwaita,hicolor
Example=folder
# Small sizes are listed first on purpose: Qt and the freedesktop lookup
# return the FIRST listed directory whose size matches the request, and the
# scalable directories match every size from 8 to 512. Listing scalable/*
# first would hide the pixel-aligned 16 and 24 px icons.
# Type=Threshold: the 16 px drawings serve 14-18 px requests and the 24 px
# drawings serve 20-28 px requests (a 22 px panel, for example). Other sizes
# use the scalable drawings.
Directories=16/actions,16/apps,16/devices,16/mimetypes,16/places,16/status,24/actions,24/devices,24/mimetypes,24/places,24/status,scalable/actions,scalable/apps,scalable/devices,scalable/mimetypes,scalable/places,scalable/status

[16/actions]
Size=16
Context=Actions
Type=Threshold
Threshold=2

[16/apps]
Size=16
Context=Applications
Type=Threshold
Threshold=2

[16/devices]
Size=16
Context=Devices
Type=Threshold
Threshold=2

[16/mimetypes]
Size=16
Context=MimeTypes
Type=Threshold
Threshold=2

[16/places]
Size=16
Context=Places
Type=Threshold
Threshold=2

[16/status]
Size=16
Context=Status
Type=Threshold
Threshold=2

[24/actions]
Size=24
Context=Actions
Type=Threshold
Threshold=4

[24/devices]
Size=24
Context=Devices
Type=Threshold
Threshold=4

[24/mimetypes]
Size=24
Context=MimeTypes
Type=Threshold
Threshold=4

[24/places]
Size=24
Context=Places
Type=Threshold
Threshold=4

[24/status]
Size=24
Context=Status
Type=Threshold
Threshold=4

[scalable/actions]
Size=64
Context=Actions
Type=Scalable
MinSize=8
MaxSize=512

[scalable/apps]
Size=64
Context=Applications
Type=Scalable
MinSize=8
MaxSize=512

[scalable/devices]
Size=64
Context=Devices
Type=Scalable
MinSize=8
MaxSize=512

[scalable/mimetypes]
Size=64
Context=MimeTypes
Type=Scalable
MinSize=8
MaxSize=512

[scalable/places]
Size=64
Context=Places
Type=Scalable
MinSize=8
MaxSize=512

[scalable/status]
Size=64
Context=Status
Type=Scalable
MinSize=8
MaxSize=512
